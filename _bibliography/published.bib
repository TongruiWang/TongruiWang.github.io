@article{mazurowski-wang-yao2026intermediate,
  title={On the topology of manifolds with positive intermediate curvature},
  author={Mazurowski, Liam and Wang, Tongrui and Yao, Xuan},
  journal={Advances in Mathematics},
  volume={485},
  pages={110731},
  year={2026},
  publisher={Elsevier},
  doi={10.1016/j.aim.2025.110731},
  html={https://doi.org/10.1016/j.aim.2025.110731},
  arxiv={2503.13815},
  primaryClass={math.DG},
  abstract={We formulate a conjecture relating the topology of a manifold's universal cover with the existence of metrics with positive $m$-intermediate curvature. We prove the result for manifolds of dimension $n\in\{3,4,5\}$ and for most choices of $m$ when $n=6$. As a corollary, we show that a closed, aspherical 6-manifold cannot admit a metric with positive $4$-intermediate curvature.}
}

@article{li-wang-yao2025lens,
  title={Minimal surfaces with low genus in lens spaces},
  author={Li, Xingzhe and Wang, Tongrui and Yao, Xuan},
  journal={Journal f\"ur die reine und angewandte Mathematik (Crelle's Journal)},
  volume={2025},
  number={828},
  pages={175--218},
  year={2025},
  publisher={De Gruyter},
  doi={10.1515/crelle-2025-0061},
  html={https://doi.org/10.1515/crelle-2025-0061},
  arxiv={2406.12584},
  primaryClass={math.DG},
  abstract={Given a Riemannian $\mathbb{RP}^3$ with a bumpy metric or a metric of positive Ricci curvature, we show that there either exist four distinct minimal real projective planes, or exist one minimal real projective plane together with two distinct minimal 2-spheres. Moreover, using the same strategy, we show that in the lens space $L(4m,2m\pm1)$, $m\ge1$, with a bumpy metric or a metric of positive Ricci curvature, there either exist $N(m)$ distinct minimal Klein bottles, or exist one minimal Klein bottle and three distinct minimal 2-spheres.}
}
